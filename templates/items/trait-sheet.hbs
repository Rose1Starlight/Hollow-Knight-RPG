<form class="hollow-knight sheet item trait" autocomplete="off">
    <header class="hk-item-header">
        <img src="{{item.img}}" data-edit="img" title="{{item.name}}" width="64" height="64"/>
        <div class="hk-item-details">
            <input name="name" type="text" value="{{item.name}}" placeholder="Trait Name"/>
            <div class="hk-flex-row hk-gap-sm">
                <select name="system.traitType">
                    <option value="attribute" {{#if (eq system.traitType "attribute")}}selected{{/if}}>Attribute</option>
                    <option value="mental" {{#if (eq system.traitType "mental")}}selected{{/if}}>Mental</option>
                    <option value="physiological" {{#if (eq system.traitType "physiological")}}selected{{/if}}>Physiological</option>
                    <option value="sense" {{#if (eq system.traitType "sense")}}selected{{/if}}>Sense</option>
                    <option value="mystical" {{#if (eq system.traitType "mystical")}}selected{{/if}}>Mystical</option>
                    <option value="body" {{#if (eq system.traitType "body")}}selected{{/if}}>Body</option>
                    <option value="movement" {{#if (eq system.traitType "movement")}}selected{{/if}}>Movement</option>
                    <option value="naturalDefense" {{#if (eq system.traitType "naturalDefense")}}selected{{/if}}>Natural Defense</option>
                </select>
                <label style="font-size:0.8rem; color:var(--hk-text-secondary); display:flex; align-items:center; gap:0.25rem;">
                    <input type="checkbox" name="system.isSubTrait" {{#if system.isSubTrait}}checked{{/if}}/> Sub-Trait
                </label>
            </div>
        </div>
    </header>
    <section class="hk-item-stats">
        <div class="hk-stat-row">
            <label>Hunger Cost</label>
            <input type="number" name="system.hungerCost" value="{{system.hungerCost}}" min="-10" max="25"/>
        </div>
        <div class="hk-stat-row">
            <label>Parent Trait</label>
            <input type="text" name="system.parentTrait" value="{{system.parentTrait}}" placeholder="Only if sub-trait"/>
        </div>
    </section>
    <section class="hk-biography">
        <h3>Effect Description</h3>
        <textarea name="system.effect" placeholder="Describe the trait's mechanical effect...">{{system.effect}}</textarea>
    </section>
</form>