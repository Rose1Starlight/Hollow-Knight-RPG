<div class="hk-chat-card hk-roll-card">
 <div class="card-header">
  <img src="{{actorImg}}" width="36" height="36" style="border-radius:50%;margin-right:8px;"/>
  <h3>{{title}}</h3>
 </div>
 <div class="card-body">
  <div class="roll-info">
   <span class="dice-count">{{diceCount}}d6</span>
   <span class="target">Target: 5+</span>
  </div>
  <div class="roll-results">
   {{#each results}}
   <span class="die {{#if this.success}}success{{else}}failure{{/if}}">{{this.value}}</span>
   {{/each}}
  </div>
  <div class="roll-summary">
   <strong>Successes: {{successes}}</strong>
   {{#if rerolls}}
   <span class="reroll-info">(Rerolled: {{rerolls}})</span>
   {{/if}}
  </div>
  {{#if description}}
  <div class="card-description">{{description}}</div>
  {{/if}}
 </div>
</div>