<div class="hk-chat-card hk-spell-card">
  <div class="card-header">
    <img src="{{actorImg}}" width="36" height="36" style="border-radius:50%;margin-right:8px;"/>
    <h3>{{title}}</h3>
  </div>
  <div class="card-body">
    <div class="spell-info">
      <span class="soul-cost">Soul Cost: {{soulCost}}</span>
      <span class="difficulty">Difficulty: {{difficulty}}</span>
      <span class="range">Range: {{range}}</span>
      <span class="duration">Duration: {{duration}}</span>
    </div>
    {{#if rollResults}}
    <div class="roll-results">
      <span>Successes: <strong>{{successes}}</strong></span>
    </div>
    {{/if}}
    <div class="card-description">{{description}}</div>
    {{#if modifiers}}
    <div class="spell-modifiers">
      <strong>Modifiers:</strong> {{modifiers}}
    </div>
    {{/if}}
  </div>
</div>